{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/stream/:id/audio",
      "destination": "/api/stream?id=:id"
    },
    {
      "source": "/api/radio/:id",
      "destination": "/api/radio?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}