{
  // The Android backend (src/native) runs the server's own modules in the app, so it is checked with Node's types
  // available (the server code mentions them even where the Android build swaps those modules out).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"],
  "exclude": []
}
