{
  "name": "@musike/mobile",
  "private": true,
  "version": "1.5.1",
  "description": "Musike for Android: the web app with the server's work done on the phone (Capacitor).",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @musike/web build:native && cap sync android",
    "apk": "pnpm run build && node scripts/build-apk.mjs",
    "ipa": "node scripts/build-ipa.mjs",
    "open": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "typescript": "^7.0.2"
  }
}
